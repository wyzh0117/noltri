{
  "name": "@noltri/desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build",
    "build:runtime": "node scripts/build-runtime.mjs",
    "release:mac": "tauri build && node scripts/verify-macos.mjs",
    "verify:mac": "node scripts/verify-macos.mjs",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@noltri/api-client": "workspace:*",
    "@noltri/schema": "workspace:*",
    "@noltri/shared": "workspace:*",
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
