{
  "name": "@noltri/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build",
    "build:runtime": "node scripts/build-runtime.mjs",
    "release:mac": "tauri build && node scripts/verify-macos.mjs",
    "verify:mac": "node scripts/verify-macos.mjs",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@noltri/api-client": "workspace:*",
    "@noltri/schema": "workspace:*",
    "@noltri/shared": "workspace:*",
    "@tauri-apps/api": "^2.12.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-katex": "^2.0.3",
    "mermaid": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
