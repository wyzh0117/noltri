{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知序",
  "version": "0.1.4",
  "identifier": "com.noltri.companion",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:runtime && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "知序 · 我的知识库",
        "url": "main.html",
        "width": 1360,
        "height": 900,
        "minWidth": 780,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; font-src 'self' data:; connect-src 'self' http: https: ws: wss:; worker-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "publisher": "知序 Noltri",
    "copyright": "© 知序 Noltri",
    "shortDescription": "网页、Agent 与论文摘录知识库",
    "longDescription": "知序把网页、Agent 对话与论文摘录收集到同一资料库，并按学科方向组织、关联与对读。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/noltri-runtime"],
    "resources": [
      "resources/core-server.mjs",
      "resources/mcp-server.mjs"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
