# ---------------------------------------------------------------------------
# 知序 Noltri — Notes 3.0 environment template
# Copy to .env.local, fill in matching nonempty local tokens, then explicitly
# select it with NOLTRI_ENV_FILE=/absolute/path/to/.env.local.
# Core/MCP do not discover parent checkout .env files. Rust does not parse dotenv;
# also export the same NOLTRI_ACCESS_TOKEN in the terminal launching desktop.
# Every value below is read by exactly one layer; nothing is hardcoded in UI.
# ---------------------------------------------------------------------------

# --- Runtime selection -----------------------------------------------------
# sqlite   = one local profile file    (a desktop profile)
# memory   = in-process store          (local dev / tests only)
STORAGE_DRIVER=sqlite
# openai   = any OpenAI-compatible endpoint, BYOK (production provider)
# offline  = deterministic no-network provider (dev / tests only)
AI_PROVIDER=offline

# --- Knowledge Core --------------------------------------------------------
PORT=18887
CORS_ORIGIN=*
# Identity used when no credential is presented (local single-user dev).
NOLTRI_DEV_USER_ID=local-dev-user
NOLTRI_DEV_REQUIRE_TOKEN=true
# Set DEV_TOKEN and ACCESS_TOKEN to the same nonempty local token.
NOLTRI_DEV_TOKEN=

# --- Local profile ---------------------------------------------------------
# Blank keeps the defaults: ~/.noltri-notes/data/noltri.sqlite, or <NOLTRI_DATA_DIR>/noltri.sqlite.
NOLTRI_DATA_DIR=
NOLTRI_SQLITE_FILE=
# Where 本地客户端授权 grants live; blank keeps the single-credential behaviour.
NOLTRI_GRANT_FILE=

# --- AI provider (BYOK) ----------------------------------------------------
# Works with OpenAI, OpenRouter, Together, Groq, LM Studio, llama.cpp server,
# or anything else exposing /chat/completions + /embeddings.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBED_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536
AI_REQUEST_TIMEOUT_MS=45000

# --- Classification thresholds (config, never UI-side constants) -----------
CLASSIFY_HIGH_CONFIDENCE=0.75
CLASSIFY_MEDIUM_CONFIDENCE=0.55
SIMILARITY_ATTACH_THRESHOLD=0.82
SIMILARITY_SEARCH_LIMIT=8

# --- Clients ---------------------------------------------------------------
KNOWLEDGE_API_URL=http://localhost:18887
NOLTRI_API_BASE_URL=http://localhost:18887
NOLTRI_ACCESS_TOKEN=
AUTH_REQUIRED=true
# Native desktop never attaches to an external service unless explicitly opted in.
# Export this in the desktop parent environment only when deliberately using one.
NOLTRI_USE_EXTERNAL_RUNTIME=0
MCP_PORT=18890
