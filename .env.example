# ---------------------------------------------------------------------------
# 知序 Noltri — V1 environment template
# Copy to .env and fill in what you actually use.
# Every value below is read by exactly one layer; nothing is hardcoded in UI.
# ---------------------------------------------------------------------------

# --- Runtime selection -----------------------------------------------------
# supabase = cloud Postgres + pgvector   (SupabaseRepository)
# memory   = in-process store             (local dev / tests only)
STORAGE_DRIVER=memory
# openai   = any OpenAI-compatible endpoint, BYOK (production provider)
# offline  = deterministic no-network provider (dev / tests only)
AI_PROVIDER=offline

# --- Knowledge Core --------------------------------------------------------
PORT=8787
CORS_ORIGIN=*
# Identity used when no Supabase JWT is presented (local single-user dev).
NOLTRI_DEV_USER_ID=local-dev-user
NOLTRI_DEV_REQUIRE_TOKEN=false
NOLTRI_DEV_TOKEN=

# --- Supabase / Postgres ---------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler (port 6543) for app traffic.
DATABASE_URL=
# Direct connection (port 5432) — required for migrations.
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI provider (BYOK) ----------------------------------------------------
# Works with OpenAI, OpenRouter, Together, Groq, LM Studio, llama.cpp server,
# or anything else exposing /chat/completions + /embeddings.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBED_MODEL=text-embedding-3-small
AI_EMBEDDING_DIM=1536
AI_REQUEST_TIMEOUT_MS=45000

# --- Classification thresholds (config, never UI-side constants) -----------
CLASSIFY_HIGH_CONFIDENCE=0.75
CLASSIFY_MEDIUM_CONFIDENCE=0.55
SIMILARITY_ATTACH_THRESHOLD=0.82
SIMILARITY_SEARCH_LIMIT=8

# --- Clients ---------------------------------------------------------------
NEXT_PUBLIC_KNOWLEDGE_API_URL=http://localhost:8787
KNOWLEDGE_API_URL=http://localhost:8787
NOLTRI_API_BASE_URL=http://localhost:8787
NOLTRI_ACCESS_TOKEN=
MCP_PORT=8790
