{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "NOLTRI_ENV",
    "KNOWLEDGE_API_URL",
    "NOLTRI_API_BASE_URL",
    "NOLTRI_ACCESS_TOKEN",
    "NOLTRI_DEV_USER_ID",
    "AI_PROVIDER",
    "AI_API_KEY",
    "AI_BASE_URL",
    "AI_CHAT_MODEL",
    "AI_EMBED_MODEL",
    "AI_EMBEDDING_DIM",
    "AI_REQUEST_TIMEOUT_MS",
    "PORT",
    "MCP_PORT",
    "CORS_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": []
    },
    "gate": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
